# Copy to .env (never commit the real file). All variables are optional: the site works without them.
# Vite exposes only variables prefixed with VITE_ to the browser, so never put secrets here.

# POST endpoint for the /contact project-brief form (Formspree, Getform, Basin, or your own API).
# Receives JSON: name, email, phone, company, service, budget, timeline, message, source, sentAt.
# If empty, or if the request fails, the form offers a pre-filled email / WhatsApp message instead.
VITE_CONTACT_ENDPOINT=

# POST endpoint for the newsletter signup (receives JSON: { email, source }).
# The signup form stays hidden everywhere until this is set.
VITE_NEWSLETTER_ENDPOINT=
